{
  "name": "Drone playground",
  "build": {
    "context": "..",
    "dockerfile": "../docker/Dockerfile",
    "target": "dev"
  },
  "hostRequirements": {
    "gpu": "optional"
  },
  "runArgs": ["--gpus", "all"],
  "workspaceFolder": "/workspaces/drone-playground",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/drone-playground,type=bind",
  "mounts": [
    "source=\\\\wsl$\\Ubuntu\\tmp\\.X11-unix,target=/wslg-x11,type=bind,readonly"
  ],
  "containerEnv": {
    "ROS_DOMAIN_ID": "83",
    "RMW_IMPLEMENTATION": "rmw_fastrtps_cpp"
  },
  "forwardPorts": [6080, 8765, 8888],
  "portsAttributes": {
    "6080": { "label": "Gazebo (noVNC)" },
    "8765": { "label": "Foxglove bridge" },
    "8888": { "label": "JupyterLab" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.debugpy",
        "ms-python.mypy-type-checker",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "ms-iot.vscode-ros",
        "timonwong.shellcheck"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.analysis.diagnosticMode": "workspace",
        "jupyter.kernels.excludePythonEnvironments": [],
        "jupyter.jupyterServerType": "local",
        "notebook.formatOnSave.enabled": true,
        "notebook.defaultFormatter": "charliermarsh.ruff",
        "notebook.codeActionsOnSave": {
          "notebook.source.fixAll": "explicit",
          "notebook.source.organizeImports": "explicit"
        },
        "mypy-type-checker.cwd": "${workspaceFolder}/control",
        "mypy-type-checker.importStrategy": "fromEnvironment",
        "ruff.cwd": "${workspaceFolder}/control",
        "ruff.importStrategy": "fromEnvironment",
        "ruff.lint.enable": true,
        "ruff.format.enable": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
          }
        }
      }
    }
  }
}